{
  "name": "hite-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "HITE — vibe coding for video editing. Describe the edit. Get the edit.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:verify": "node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "qa": "playwright test --config=qa/playwright.config.ts",
    "qa:ui": "playwright test --config=qa/playwright.config.ts --ui",
    "qa:headed": "playwright test --config=qa/playwright.config.ts --headed",
    "qa:forge": "playwright test --config=qa/playwright.config.ts --project=forge-desktop --project=forge-laptop",
    "qa:probe": "playwright test --config=qa/playwright.config.ts --project=probe",
    "qa:hammer": "playwright test --config=qa/playwright.config.ts --project=hammer",
    "qa:sentinel": "playwright test --config=qa/playwright.config.ts --project=sentinel",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "sample:take": "node scripts/take/render.mjs",
    "lint:registry": "tsx scripts/lint-registry.ts",
    "verify:provider": "node --env-file-if-exists=.env.local --import tsx scripts/verify-provider.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "prebuild": "tsx scripts/lint-registry.ts && tsx scripts/build-registry.ts && tsx scripts/build-landing-fixtures.ts",
    "predev": "tsx scripts/build-registry.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.111",
    "@ai-sdk/deepseek": "^2.0.56",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/groq": "^3.0.60",
    "@ai-sdk/openai": "^3.0.98",
    "@ai-sdk/openai-compatible": "^2.0.69",
    "@ai-sdk/xai": "^3.0.123",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@remotion/bundler": "4.0.450",
    "@remotion/player": "4.0.450",
    "@remotion/renderer": "4.0.450",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.47.0",
    "ai": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "immer": "^11.1.8",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0",
    "n8ao": "^2.0.1",
    "next": "^16.0.0",
    "postprocessing": "^6.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.0.0",
    "react-rnd": "^10.4.14",
    "react-window": "^1.8.10",
    "remotion": "4.0.450",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.185.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "supabase": "^2.92.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "remotion": "4.0.450",
      "@remotion/player": "4.0.450",
      "@remotion/media-parser": "4.0.450",
      "@remotion/media-utils": "4.0.450",
      "@remotion/renderer": "4.0.450",
      "@remotion/bundler": "4.0.450"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
